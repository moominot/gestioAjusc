# Copieu-lo a .env.local i ompliu-lo amb les dades del vostre projecte Supabase
# (Project Settings → API). Cap d'aquests valors és secret: la clau anon està
# pensada per anar al navegador i qui mana sobre les dades és l'RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adreça pública on es desplega, per als enllaços d'entrada del correu.
NEXT_PUBLIC_URL_BASE=http://localhost:3000
